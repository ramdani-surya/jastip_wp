# =============================================================================
# Production Environment — Titip Cirebon
# =============================================================================
# Cara penggunaan:
#   cp .env.prod.example .env.prod
#   # Edit .env.prod: ganti semua nilai "GANTI_..." dan "YOUR_DOMAIN.com"
#   make prod-up
#
# JANGAN pernah commit file .env.prod ke Git!
# =============================================================================

PROJECT_NAME=titip-cirebon

# Domain production (tanpa https://, tanpa trailing slash).
# Bisa diisi nama domain (misal: titipcirebon.com) atau IP VPS (misal: 103.93.134.96).
WORDPRESS_DOMAIN=103.93.134.96

# Protokol WordPress (http atau https). Default: http.
# Gunakan http jika VPS belum memiliki sertifikat SSL / masih menggunakan IP address langsung.
# Gunakan https jika sudah memasang domain dan sertifikat SSL.
WORDPRESS_PROTOCOL=http

# File konfigurasi Nginx production:
# - Mode HTTP (default, tanpa SSL, akses via IP): ./docker/nginx/conf.d/default.prod.http.conf
# - Mode HTTPS (dengan SSL dan redirect 80->443): ./docker/nginx/conf.d/default.prod.ssl.conf
NGINX_CONF_FILE=./docker/nginx/conf.d/default.prod.http.conf

# Database
MYSQL_DATABASE=titip_cirebon
MYSQL_USER=titip_cirebon
MYSQL_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_ACAK_MIN_32_KARAKTER
MYSQL_ROOT_PASSWORD=GANTI_DENGAN_PASSWORD_ROOT_KUAT_ACAK_MIN_32_KARAKTER

# WordPress
WP_ENVIRONMENT_TYPE=production
WP_DEBUG=false
WP_SITE_TITLE=Titip Cirebon
WP_ADMIN_USER=GANTI_BUKAN_admin_ATAU_titip_admin
WP_ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_ADMIN_KUAT_MIN_20_KARAKTER
WP_ADMIN_EMAIL=admin@YOUR_DOMAIN.com
